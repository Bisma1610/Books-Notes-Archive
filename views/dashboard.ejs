<!DOCTYPE html>
<html>
  <head>
    <title>Dashboard</title>
    <link rel="stylesheet" href="/css/styles.css" />
    <link rel="stylesheet" href="/css/tailwind.css" />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css"
    />
  </head>
  <body class="bg-[#101510] text-white min-h-screen px-6 py-8">
    <div class="max-w-4xl mx-auto">
      <h1 class="text-3xl font-bold mb-2 text-[#1F7D53]">
        Welcome, <%= user.username %>!
      </h1>
      <p class="text-sm mb-6 text-[#1F7D53]">Your email: <%= user.email %></p>

      <h2 class="text-2xl font-semibold mb-4 text-[#1F7D53]">
        Your Notes & Ratings
      </h2>

      <% if (books.length > 0) { %> <% books.forEach((book, index) => { %>
      <div
        class="bg-[#27391C] p-4 mb-6 rounded-lg shadow-lg flex flex-col md:flex-row gap-4 relative animate__animated animate__fadeInUp"
        style="animation-delay: <%= 0.1 * index %>s"
      >
        <% if (book.thumbnail) { %>
        <img
          src="<%= book.thumbnail %>"
          alt="Thumbnail"
          class="max-w-[120px] max-h-[180px] object-contain rounded shadow-md"
        />
        <% } %>

        <div class="flex-1">
          <h3 class="text-xl font-semibold mb-1 text-[#1F7D53]">
            <%= book.title %>
          </h3>
          <p class="text-sm mb-1">
            <span class="text-[#1F7D53] font-semibold">Author(s):</span> <%=
            book.author %>
          </p>
          <p class="text-sm mb-1">
            <span class="text-[#1F7D53] font-semibold">Your Rating:</span> <%=
            book.rating %> / 5
          </p>
          <p class="text-sm mb-1">
            <span class="text-[#1F7D53] font-semibold">Your Note:</span><br />
            <span class="text-white whitespace-pre-wrap"><%= book.note %></span>
          </p>

          <div class="flex justify-end items-center gap-3 mt-4">
            <!-- Edit Button -->
            <a
              href="/editbook?title=<%= encodeURIComponent(book.title) %>"
              class="inline-flex items-center justify-center px-4 py-2 h-10 rounded text-white font-medium text-sm bg-[#1F7D53] hover:bg-[#176345] transition !no-underline"
            >
              Edit
            </a>

            <!-- Delete Button  -->
            <form
              action="/delete-review"
              method="POST"
              onsubmit="return confirm('Are you sure you want to delete this review?');"
              class="m-0 p-0"
            >
              <!-- Pass the title as a hidden input -->
              <input type="hidden" name="title" value="<%= book.title %>" />

              <button
                type="submit"
                class="inline-flex items-center justify-center px-4 py-2 h-10 rounded text-white font-medium text-sm bg-red-600 hover:bg-red-700 transition align-middle"
              >
                Delete
              </button>
            </form>
          </div>
        </div>
      </div>

      <% }); %> <% } else { %>
      <p class="text-gray-400">You haven't reviewed any books yet.</p>
      <% } %>

      <div class="mt-6 flex gap-4">
        <a href="/" class="text-[#1F7D53] hover:underline">Search More Books</a>
        <a href="/logout" class="text-[#1F7D53] hover:underline">Logout</a>
      </div>
    </div>
  </body>
</html>
